local.properties

# Build output. Anchored on purpose: a bare `build/` also ignores the SOURCE packages
# core/android/.../build/ and app/.../screens/build/ (ToolchainManager, AndroidBuildEngine,
# SafeDirUnzip, BuildScreen), which silently vanished from git-based zips and CI checkouts.
/build/
/app/build/
/core/*/build/
.gradle/

# IDE / scratch
.superpowers/
*.apk
*.aab

# Generated by tools/build_source_mirror.py (CI and local builds regenerate it)
app/src/main/assets/source/

# Generated, machine-specific verification output
docs/FINAL_RELEASE_AUDIT.json

# nodejs-mobile runtime, downloaded + hash-verified by the downloadNodeLibs
# Gradle task in core/android (never committed: 57 MB of prebuilt binaries)
core/android/libnode/
