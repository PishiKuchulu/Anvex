# Keep shell entry points runnable after Windows checkouts/ZIP creation.
gradlew text eol=lf
gradlew.bat text eol=crlf

# Keep build and source metadata deterministic across operating systems.
*.gradle.kts text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
